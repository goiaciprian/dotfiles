# ── Completions & FPATH ───────────────────────────────────
typeset -U fpath FPATH
[[ -d "$HOME/.zsh/completions" ]] && fpath=("$HOME/.zsh/completions" $fpath)

# Completion styles
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|[._-]=* r:|=*' 'l:|=* r:|=*'

# ── Plugins (Sheldon) ─────────────────────────────────────
# zsh-autosuggestions settings
# ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=#663399,standout"
ZSH_AUTOSUGGEST_BUFFER_MAX_SIZE="20"
ZSH_AUTOSUGGEST_USE_ASYNC=1

setopt AUTOCD
setopt NOBEEP
setopt NUMERIC_GLOB_SORT

# Load Sheldon plugins (cached, fast)
if (( $+commands[sheldon] )); then
  eval "$(sheldon source)"
fi

# Fallback: initialize completions if not loaded by a plugin (e.g. zsh-autocomplete)
if ! (( $+functions[_main_complete] )); then
  [[ -d "${XDG_CACHE_HOME:-$HOME/.cache}/zsh" ]] || mkdir -p "${XDG_CACHE_HOME:-$HOME/.cache}/zsh"
  autoload -Uz compinit
  compinit -d "${XDG_CACHE_HOME:-$HOME/.cache}/zsh/zcompdump"
fi

# ── Environment & PATH ────────────────────────────────────
# Ensure uniqueness across PATH entries
typeset -U path PATH

export GPG_TTY=$(tty)
export GOROOT="/usr/local/go"
export GOPATH="$HOME/go"
export BUN_INSTALL="$HOME/.bun"
export PNPM_HOME="$HOME/.local/share/pnpm"

path=(
  "$HOME/.local/bin"
  "$PNPM_HOME"
  "$PNPM_HOME/bin"
  "$BUN_INSTALL/bin"
  "$GOROOT/bin"
  "$GOPATH/bin"
  "$HOME/.yarn/bin"
  "$HOME/.config/yarn/global/node_modules/.bin"
  "$HOME/.nub/bin"
  "/opt/gradle/gradle-9.0.0/bin"
  "/snap/bin"
  $path
)
export PATH

# ── History ───────────────────────────────────────────────
HISTFILE="$HOME/.zsh_history"
HISTSIZE=5000
SAVEHIST=$HISTSIZE
HISTDUP=erase

setopt appendhistory
setopt sharehistory
setopt hist_ignore_space
setopt hist_ignore_all_dups
setopt hist_save_no_dups
setopt hist_find_no_dups

# ── Terminal & Keybindings ────────────────────────────────
# Fix slowness of pastes with zsh-syntax-highlighting
pasteinit() {
  OLD_SELF_INSERT=${${(s.:.)widgets[self-insert]}[2,3]}
  zle -N self-insert url-quote-magic
}

pastefinish() {
  zle -N self-insert $OLD_SELF_INSERT
}
zstyle :bracketed-paste-magic paste-init pasteinit
zstyle :bracketed-paste-magic paste-finish pastefinish

# Keybindings
bindkey '^H' backward-kill-word
bindkey "^[[1;5C" forward-word
bindkey "^[[1;5D" backward-word

# ── Prompt ────────────────────────────────────────────────
eval "$(oh-my-posh init zsh --config ~/.poshthemes/cipriangodlike.omp.json)"

# ── Aliases ───────────────────────────────────────────────
alias ls="eza -la --icons --group-directories-first --sort name"
alias t="todos.exe"
alias q="quit"
alias tf="terraform"
alias hl="rg --passthru"

# ── Functions ─────────────────────────────────────────────
function gst() {
  git status
}

function forecast() {
  curl "wttr.in/${1:-}"
}

function y() {
  local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
  yazi "$@" --cwd-file="$tmp"
  if cwd="$(command cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
    builtin cd -- "$cwd"
  fi
  rm -f -- "$tmp"
}

function misea() {
  eval "$(mise activate zsh)"
}

# ── Tool Integrations & Completions ───────────────────────
# NVM (Node Version Manager)
export NVM_DIR="$HOME/.nvm"
[ -s "$NVM_DIR/nvm.sh" ] && \. "$NVM_DIR/nvm.sh"
[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"

# Zoxide
eval "$(zoxide init --cmd cd zsh)"

# Bun completions
[[ -s "$HOME/.zsh/completions/_bun" ]] && source "$HOME/.zsh/completions/_bun"
[[ -s "$HOME/.oh-my-zsh/completions/_bun" ]] && source "$HOME/.oh-my-zsh/completions/_bun"

# GitHub CLI completions
if (( $+commands[gh] )); then
  eval "$(gh completion -s zsh)"
fi

# Terraform / Bash completions
autoload -U +X bashcompinit && bashcompinit
complete -o nospace -C /usr/bin/terraform terraform
